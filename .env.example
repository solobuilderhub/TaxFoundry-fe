# Copy to .env.local.

# Base URL of the TaxFoundry arc server (apps/server). Used by arc-next
# (configureClient) and the better-auth client (auth calls hit /api/auth/*).
NEXT_PUBLIC_API_URL=http://localhost:8040

# Must MATCH the server's better-auth secret. Enables the fast cookie-cache
# path in getServerSession(); if absent/mismatched it safely falls back to a
# backend /api/auth/get-session fetch, so it's optional for local dev.
BETTER_AUTH_SECRET=

# Optional: server URL for server-side session validation (defaults to
# NEXT_PUBLIC_API_URL). Set if the SSR runtime reaches the API on a different host.
# BACKEND_URL=http://localhost:8040
