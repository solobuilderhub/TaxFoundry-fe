# TaxFoundry web — environment
#
# Copy to `.env.local` for local development, or set these in your host's
# environment for a deployment. Every file matching `.env*` is gitignored
# except this one.

# ─────────────────────────────────────────────────────────────────────────────
# Required
# ─────────────────────────────────────────────────────────────────────────────

# Where the API is reachable FROM THE BROWSER.
#
# There is no proxy: the browser calls the API cross-origin, so in a deployment
# this must be the API's public URL, not an internal hostname — and that exact
# origin must appear in the API's own CORS_ORIGINS or every request is blocked.
NEXT_PUBLIC_API_URL=http://localhost:8040

# This app's own public URL. Used for absolute links and metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─────────────────────────────────────────────────────────────────────────────
# Optional
# ─────────────────────────────────────────────────────────────────────────────

# Must MATCH the API's BETTER_AUTH_SECRET exactly. It enables the fast
# cookie-cache path when validating a session on the server; without it the app
# falls back to asking the API, which is correct but slower. A MISMATCH is not
# an error — it silently takes the slow path, so if sessions feel sluggish in
# production, check this first.
# BETTER_AUTH_SECRET=

# Where the SSR runtime reaches the API, if that differs from the browser's URL
# — a container talking to a sibling service over an internal network, for
# example. Defaults to NEXT_PUBLIC_API_URL.
# BACKEND_URL=http://localhost:8040
